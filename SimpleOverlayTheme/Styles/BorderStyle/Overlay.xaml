<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:commonHelper="clr-namespace:SimpleOverlayTheme.Helpers.Common"
                    xmlns:overlayHelper="clr-namespace:SimpleOverlayTheme.Helpers.Overlay"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Overlay Default Border -->
    <Style x:Key="SimpleOverlayTheme.Border.OverlayBorder" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Thickness.Default}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="commonHelper:State.State" Value="Default"/>
        <Setter Property="overlayHelper:Display.DisplayBackground" Value="True"/>
        <Setter Property="overlayHelper:Display.DisplayOutline" Value="True"/>
        <Setter Property="overlayHelper:Display.DisplayDefaultBackground" Value="True"/>
        <Setter Property="overlayHelper:Display.DisplayDefaultOutline" Value="True"/>
        <Style.Triggers>
            <!--Background-->
            <Trigger Property="overlayHelper:Display.DisplayBackground" Value="False">
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Active"/>
                    <Condition Property="overlayHelper:Display.DisplayBackground" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Background.Active}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Default"/>
                    <Condition Property="overlayHelper:Display.DisplayBackground" Value="True"/>
                    <Condition Property="overlayHelper:Display.DisplayDefaultBackground" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Background.Default}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Disable"/>
                    <Condition Property="overlayHelper:Display.DisplayBackground" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Background.Disable}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="MouseOver"/>
                    <Condition Property="overlayHelper:Display.DisplayBackground" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Background.MouseOver}"/>
            </MultiTrigger>
            <!--Outline-->
            <Trigger Property="overlayHelper:Display.DisplayOutline" Value="False">
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Active"/>
                    <Condition Property="overlayHelper:Display.DisplayOutline" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Outline.Active}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Default"/>
                    <Condition Property="overlayHelper:Display.DisplayOutline" Value="True"/>
                    <Condition Property="overlayHelper:Display.DisplayDefaultOutline" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Outline.Default}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Disable"/>
                    <Condition Property="overlayHelper:Display.DisplayOutline" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Outline.Disable}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="MouseOver"/>
                    <Condition Property="overlayHelper:Display.DisplayOutline" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Outline.MouseOver}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Overlay Mask Border -->
    <Style x:Key="SimpleOverlayTheme.Border.OverlayMaskBorder" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Thickness.Zero}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Border.Outline.Default}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="OpacityMask" Value="{x:Null}"/>
        <Setter Property="commonHelper:State.State" Value="Default"/>
        <Setter Property="commonHelper:Mask.DefaultImage">
            <!--Dummy-->
            <Setter.Value>
                <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme;component/SolutionFolder/Resource/Mask/empty.png"/>
            </Setter.Value>
        </Setter>
        <Setter Property="commonHelper:Mask.UseCustomImageActive" Value="False"/>
        <Setter Property="commonHelper:Mask.UseCustomImageDisable" Value="False"/>
        <Setter Property="commonHelper:Mask.UseCustomImageMouseOver" Value="False"/>
        <Setter Property="commonHelper:Mask.CustomImageActive" Value="{x:Null}"/>
        <Setter Property="commonHelper:Mask.CustomImageDisable" Value="{x:Null}"/>
        <Setter Property="commonHelper:Mask.CustomImageMouseOver" Value="{x:Null}"/>
        <Setter Property="overlayHelper:Display.DisplayBackground" Value="True"/>
        <Setter Property="overlayHelper:Display.DisplayOutline" Value="True"/>
        <Setter Property="overlayHelper:Display.DisplayDefaultBackground" Value="True"/>
        <Setter Property="overlayHelper:Display.DisplayDefaultOutline" Value="True"/>
        <Style.Triggers>
            <!--Background-->
            <Trigger Property="overlayHelper:Display.DisplayBackground" Value="False">
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Active"/>
                    <Condition Property="overlayHelper:Display.DisplayBackground" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Mask.Background.Active}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Default"/>
                    <Condition Property="overlayHelper:Display.DisplayBackground" Value="True"/>
                    <Condition Property="overlayHelper:Display.DisplayDefaultBackground" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Mask.Background.Default}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Disable"/>
                    <Condition Property="overlayHelper:Display.DisplayBackground" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Mask.Background.Disable}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="MouseOver"/>
                    <Condition Property="overlayHelper:Display.DisplayBackground" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Mask.Background.MouseOver}"/>
            </MultiTrigger>
            <!--Outline-->
            <Trigger Property="overlayHelper:Display.DisplayOutline" Value="False">
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Active"/>
                    <Condition Property="overlayHelper:Display.DisplayOutline" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Outline.Active}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Default"/>
                    <Condition Property="overlayHelper:Display.DisplayOutline" Value="True"/>
                    <Condition Property="overlayHelper:Display.DisplayDefaultOutline" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Outline.Default}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Disable"/>
                    <Condition Property="overlayHelper:Display.DisplayOutline" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Outline.Disable}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="MouseOver"/>
                    <Condition Property="overlayHelper:Display.DisplayOutline" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.Overlay.Outline.MouseOver}"/>
            </MultiTrigger>
            <!--Mask-->
            <Trigger Property="commonHelper:State.State" Value="Default">
                <Setter Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource Self}, Path=(commonHelper:Mask.DefaultImage)}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Active"/>
                    <Condition Property="commonHelper:Mask.UseCustomImageActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource Self}, Path=(commonHelper:Mask.CustomImageActive)}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Disable"/>
                    <Condition Property="commonHelper:Mask.UseCustomImageDisable" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource Self}, Path=(commonHelper:Mask.CustomImageDisable)}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="MouseOver"/>
                    <Condition Property="commonHelper:Mask.UseCustomImageMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource Self}, Path=(commonHelper:Mask.CustomImageMouseOver)}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Active"/>
                    <Condition Property="commonHelper:Mask.UseCustomImageActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource Self}, Path=(commonHelper:Mask.DefaultImage)}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="Disable"/>
                    <Condition Property="commonHelper:Mask.UseCustomImageDisable" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource Self}, Path=(commonHelper:Mask.DefaultImage)}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="commonHelper:State.State" Value="MouseOver"/>
                    <Condition Property="commonHelper:Mask.UseCustomImageMouseOver" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource Self}, Path=(commonHelper:Mask.DefaultImage)}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>