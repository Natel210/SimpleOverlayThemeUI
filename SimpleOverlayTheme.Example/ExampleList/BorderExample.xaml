<UserControl x:Class="SimpleOverlayTheme.Example.ExampleList.BorderExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimpleOverlayTheme.Example.ExampleList"
             xmlns:helpers="clr-namespace:SimpleOverlayTheme.Helpers;assembly=SimpleOverlayTheme"
             mc:Ignorable="d" 
             d:Background="White">
    <UserControl.Resources>

        <Style x:Key="gridBorder" TargetType="Border" BasedOn="{StaticResource SimpleOverlayTheme.Style.BorderStyle.Border}">
            <Setter Property="BorderBrush" Value="#88888888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
        </Style> <Style x:Key="borderBase" TargetType="Border" BasedOn="{StaticResource SimpleOverlayTheme.Style.BorderStyle.Border}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>
        <Style x:Key="borderEmptyBase" TargetType="Border" BasedOn="{StaticResource SimpleOverlayTheme.Style.BorderStyle.Empty}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>
        <Style x:Key="borderMaskBase" TargetType="Border" BasedOn="{StaticResource SimpleOverlayTheme.Style.BorderStyle.Mask}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Gray"/>
            <!--Does not apply-->
            <Setter Property="BorderBrush" Value="Gray"/>
            <!--Does not apply-->
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="helpers:BorderHelper.Mask_DefaultImageBrush">
                <Setter.Value>
                    <ImageBrush ImageSource="/SolutionFolder/Resource/Mask/check.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:BorderHelper.CustomMask_ImageBrush_AtActive">
                <Setter.Value>
                    <ImageBrush ImageSource="/SolutionFolder/Resource/Mask/close.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:BorderHelper.CustomMask_ImageBrush_AtDisable">
                <Setter.Value>
                    <ImageBrush ImageSource="/SolutionFolder/Resource/Mask/maximize.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:BorderHelper.CustomMask_ImageBrush_AtMouseover">
                <Setter.Value>
                    <ImageBrush ImageSource="/SolutionFolder/Resource/Mask/upArrow.png"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="borderMaskAll" TargetType="Border" BasedOn="{StaticResource borderMaskBase}">
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtActive" Value="True"/>
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtDisable" Value="True"/>
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtMouseover" Value="True"/>
        </Style>
        <Style x:Key="borderMaskDontCustom" TargetType="Border" BasedOn="{StaticResource borderMaskBase}">
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtActive" Value="True"/>
        </Style>
        <Style x:Key="borderOverlayBase" TargetType="Border" BasedOn="{StaticResource SimpleOverlayTheme.Style.BorderStyle.Overlay}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
        </Style>
        <Style x:Key="borderOverlayMaskBase" TargetType="Border" BasedOn="{StaticResource SimpleOverlayTheme.Style.BorderStyle.OverlayMask}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="helpers:BorderHelper.Mask_DefaultImageBrush">
                <Setter.Value>
                    <ImageBrush ImageSource="/SolutionFolder/Resource/Mask/check.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:BorderHelper.CustomMask_ImageBrush_AtActive">
                <Setter.Value>
                    <ImageBrush ImageSource="/SolutionFolder/Resource/Mask/close.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:BorderHelper.CustomMask_ImageBrush_AtDisable">
                <Setter.Value>
                    <ImageBrush ImageSource="/SolutionFolder/Resource/Mask/maximize.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:BorderHelper.CustomMask_ImageBrush_AtMouseover">
                <Setter.Value>
                    <ImageBrush ImageSource="/SolutionFolder/Resource/Mask/upArrow.png"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="borderOverlayMaskAll" TargetType="Border" BasedOn="{StaticResource borderOverlayMaskBase}">
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtActive" Value="True"/>
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtDisable" Value="True"/>
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtMouseover" Value="True"/>
        </Style>
        <Style x:Key="borderOverlayMaskDontCustom" TargetType="Border" BasedOn="{StaticResource borderOverlayMaskBase}">
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtActive" Value="True"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer>
