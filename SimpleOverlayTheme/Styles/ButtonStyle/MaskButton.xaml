<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:commonHelper="clr-namespace:SimpleOverlayTheme.Helpers.Common"
                    xmlns:overlayHelper="clr-namespace:SimpleOverlayTheme.Helpers.Overlay"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SimpleOverlayTheme;component/Styles/BorderStyle/General.xaml"/>
        <ResourceDictionary Source="/SimpleOverlayTheme;component/Styles/BorderStyle/Overlay.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Mask button -->
    <Style x:Key="SimpleOverlayTheme.Button.ImageMask" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.FontSize.Default}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SimpleOverlayTheme.DefaultThickness.Default}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.ColorPalette.Outline}"/>
        <Setter Property="Foreground" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.ColorPalette.Mask}"/>
        <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.ColorPalette.Background}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Width">
            <Setter.Value>
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(commonHelper:Mask.DefaultImage).ImageSource.Width"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Height">
            <Setter.Value>
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(commonHelper:Mask.DefaultImage).ImageSource.Height"/>
            </Setter.Value>
        </Setter>
        <Setter Property="commonHelper:State.State" Value="Default"/>
        <Setter Property="commonHelper:Mask.DefaultImage">
            <!--Dummy-->
            <Setter.Value>
                <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme;component/SolutionFolder/Resource/Mask/empty.png"/>
            </Setter.Value>
        </Setter>
        <Setter Property="commonHelper:Mask.UseCustomImageActive" Value="False"/>
        <Setter Property="commonHelper:Mask.UseCustomImageDisable" Value="False"/>
        <Setter Property="commonHelper:Mask.UseCustomImageMouseOver" Value="False"/>
        <Setter Property="commonHelper:Mask.CustomImageActive" Value="{x:Null}"/>
        <Setter Property="commonHelper:Mask.CustomImageDisable" Value="{x:Null}"/>
        <Setter Property="commonHelper:Mask.CustomImageMouseOver" Value="{x:Null}"/>
        <Setter Property="overlayHelper:Display.DisplayBackground" Value="True"/>
        <Setter Property="overlayHelper:Display.DisplayOutline" Value="True"/>
        <Setter Property="overlayHelper:Display.DisplayDefaultBackground" Value="True"/>
        <Setter Property="overlayHelper:Display.DisplayDefaultOutline" Value="True"/>
        <Setter Property="buttonHelper:Mask.FollowMode" Value="True"/>
        <Setter Property="buttonHelper:Border.CornerRadius" Value="0.0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="backgroundBorder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                CornerRadius="{TemplateBinding buttonHelper:Border.CornerRadius}"
                                Style="{StaticResource SimpleOverlayTheme.Border.EmptyBorder}"/>
                        <Border x:Name="imageMask"
                                Background="{TemplateBinding Foreground}"
                                BorderThickness="{DynamicResource SimpleOverlayTheme.DefaultThickness.Zero}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                CornerRadius="{TemplateBinding buttonHelper:Border.CornerRadius}"
                                Style="{StaticResource SimpleOverlayTheme.Border.MaskBorder}"
                                commonHelper:State.State="{TemplateBinding commonHelper:State.State}"
                                commonHelper:Mask.UseCustomImageActive="{TemplateBinding commonHelper:Mask.UseCustomImageActive}"
                                commonHelper:Mask.UseCustomImageDisable="{TemplateBinding commonHelper:Mask.UseCustomImageDisable}"
                                commonHelper:Mask.UseCustomImageMouseOver="{TemplateBinding commonHelper:Mask.UseCustomImageMouseOver}"
                                commonHelper:Mask.CustomImageActive="{TemplateBinding commonHelper:Mask.CustomImageActive}"
                                commonHelper:Mask.CustomImageDisable="{TemplateBinding commonHelper:Mask.CustomImageDisable}"
                                commonHelper:Mask.CustomImageMouseOver="{TemplateBinding commonHelper:Mask.CustomImageMouseOver}"/>
                        <Border x:Name="overlayBorder"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                CornerRadius="{TemplateBinding buttonHelper:Border.CornerRadius}"
                                Style="{StaticResource SimpleOverlayTheme.Border.OverlayBorder}"
                                commonHelper:State.State="{TemplateBinding commonHelper:State.State}"
                                overlayHelper:Display.DisplayBackground="{TemplateBinding overlayHelper:Display.DisplayBackground}"
                                overlayHelper:Display.DisplayDefaultBackground="{TemplateBinding overlayHelper:Display.DisplayDefaultBackground}"
                                overlayHelper:Display.DisplayDefaultOutline="{TemplateBinding overlayHelper:Display.DisplayDefaultOutline}"
                                overlayHelper:Display.DisplayOutline="{TemplateBinding overlayHelper:Display.DisplayOutline}"/>
                        <Border x:Name="overlayMask"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                OpacityMask="{TemplateBinding OpacityMask}"
                                CornerRadius="{TemplateBinding buttonHelper:Border.CornerRadius}"
                                Style="{StaticResource SimpleOverlayTheme.Border.OverlayMaskBorder}"
                                commonHelper:State.State="{TemplateBinding commonHelper:State.State}"
                                overlayHelper:Display.DisplayBackground="{TemplateBinding overlayHelper:Display.DisplayBackground}"
                                overlayHelper:Display.DisplayDefaultBackground="{TemplateBinding overlayHelper:Display.DisplayDefaultBackground}"
                                overlayHelper:Display.DisplayDefaultOutline="{TemplateBinding overlayHelper:Display.DisplayDefaultOutline}"
                                overlayHelper:Display.DisplayOutline="{TemplateBinding overlayHelper:Display.DisplayOutline}"
                                commonHelper:Mask.UseCustomImageActive="{TemplateBinding commonHelper:Mask.UseCustomImageActive}"
                                commonHelper:Mask.UseCustomImageDisable="{TemplateBinding commonHelper:Mask.UseCustomImageDisable}"
                                commonHelper:Mask.UseCustomImageMouseOver="{TemplateBinding commonHelper:Mask.UseCustomImageMouseOver}"
                                commonHelper:Mask.CustomImageActive="{TemplateBinding commonHelper:Mask.CustomImageActive}"
                                commonHelper:Mask.CustomImageDisable="{TemplateBinding commonHelper:Mask.CustomImageDisable}"
                                commonHelper:Mask.CustomImageMouseOver="{TemplateBinding commonHelper:Mask.CustomImageMouseOver}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="overlayHelper:Button.FollowMode" Value="True">
                            <Setter TargetName="overlayBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="overlayMask" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="overlayHelper:Button.FollowMode" Value="False">
                            <Setter TargetName="overlayBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="overlayMask" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="commonHelper:State.State" Value="MouseOver"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="commonHelper:State.State" Value="Active"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="commonHelper:State.State" Value="Disable"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.ColorPalette.Foreground_Disable}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>