<UserControl x:Class="SimpleOverlayTheme.Example.ExampleList.Component.Label"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimpleOverlayTheme.Example.ExampleList.Component"
             mc:Ignorable="d" Background="White">
    <GroupBox Header="Labels" Style="{StaticResource PlateGroupBox}"  FontSize="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header2}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Label" Margin="5" Style="{StaticResource SimpleOverlayTheme.Styles.LabelStyle.Label}"/>
            <Label Grid.Row="1" Content="Separator Label" Margin="5" Style="{StaticResource SimpleOverlayTheme.Styles.LabelStyle.Separator}"/>
        </Grid>
    </GroupBox>
</UserControl>
