<Project>
  <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
  <PropertyGroup>
    <!-- RootPath -->
    <RootPath Condition="'$(SolutionDir)' == ''">$(MSBuildProjectDirectory)\..\</RootPath>
    <RootPath Condition="'$(SolutionDir)' != ''">$(SolutionDir)</RootPath>
    <!-- Project -->
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(BaseOutputPath)/$(Configuration)/$(TargetFramework)/$(AssemblyName).xml</DocumentationFile>
    <!-- Metadata & License -->
    <Company>Natel210</Company>
    <Authors>Natel210</Authors>
    <Title>$(AssemblyName)</Title>
    <Copyright>MIT</Copyright>
    <Description>
      <![CDATA[
        WPF resource DLL for simple themes.
        You can use it as basic WPF.
        Example samples are included.
        The created environment is .NET 8.0
      ]]>
    </Description>
      
    <!-- Repository -->
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Natel210/SimpleOverlayThemeUI.git</RepositoryUrl>
      


    

  </PropertyGroup>
  <!--<ItemGroup>
