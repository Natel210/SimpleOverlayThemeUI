<Application x:Class="SimpleOverlayTheme.Example.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SimpleOverlayTheme.Example"
             StartupUri="MainWindow.xaml" Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SimpleOverlayTheme;component/Entry.xaml" />
                <ResourceDictionary Source="/SimpleOverlayTheme/Dummy/CurrentTheme.xaml"/>

                <ResourceDictionary Source="/UserStyles/PlateGroupBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
