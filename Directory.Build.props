      <Pack>True</Pack>
      <PackagePath>Tools\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <Link>SolutionFolder\Tools\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="$(RootPath).gitignore">
      <Link>SolutionFolder\.gitignore</Link>
    </None>
    <None Include="$(RootPath)Directory.Build.props">
      <Link>SolutionFolder\Directory.Build.props</Link>
    </None>
    --><!--<None Include="$(RootPath)LICENSE">
