<UserControl x:Class="SimpleOverlayTheme.Example.ExampleList.Component.Summary.DataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimpleOverlayTheme.Example.ExampleList.Component.Summary"
             xmlns:helpers="clr-namespace:SimpleOverlayTheme.Helpers;assembly=SimpleOverlayTheme"
             mc:Ignorable="d"
             Style="{StaticResource SimpleOverlayTheme.Styles.UserControlStyle.Empty}"
             d:Style="{StaticResource SimpleOverlayTheme.Styles.UserControlStyle.UserControl}">
    <StackPanel>
        <DataGrid Name="dataGrid" AutoGenerateColumns="True" FontSize="16" Style="{StaticResource SimpleOverlayTheme.Styles.DataGridStyle.DataGrid}" Background="Transparent" SelectionUnit="Cell" Margin="5">
        </DataGrid>
        <DataGrid Name="dataGrid3" AutoGenerateColumns="True" FontSize="16" SelectionUnit="CellOrRowHeader" Margin="5">
        </DataGrid>
    </StackPanel>
</UserControl>
