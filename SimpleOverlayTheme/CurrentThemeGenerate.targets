<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Target Name="GenerateOverlayThemeXaml" BeforeTargets="BeforeBuild"
          Condition="Exists('$(ProjectDir)current.ini') And !Exists('$(ProjectDir)ThemeSystem\Current\CurrentTheme.xaml')">
    
    <Message Text="🔧 [SimpleOverlayTheme] current.ini → CurrentTheme.xaml 생성 중..." Importance="High" />

    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)..\tools\net6.0\SimpleOverlayTheme.XamlGen.dll&quot; 
                          &quot;$(ProjectDir)current.ini&quot; 
                          &quot;$(ProjectDir)ThemeSystem\Current\CurrentTheme.xaml&quot;" />
  </Target>

</Project>