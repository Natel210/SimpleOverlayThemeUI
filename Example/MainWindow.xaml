<Window x:Class="SimpleOverlayTheme.Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleOverlayTheme.Example"
        xmlns:exampleList="clr-namespace:SimpleOverlayTheme.Example.ExampleList"
        mc:Ignorable="d"
        Style="{StaticResource SimpleOverlayTheme.Styles.WindowStyle.Window}"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <TabControl Background="Transparent">
            <TabItem Header="Summary" Background="Transparent">
                <exampleList:SummaryExample/>
            </TabItem>

            <TabItem Header="Overlay" Background="Transparent">
                <exampleList:OverlayExample/>
            </TabItem>
        </TabControl>
        <Button Content="TEST" Click="Button_Click"/>
    </StackPanel>
</Window>
