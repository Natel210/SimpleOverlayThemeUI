    <ItemGroup>
        <None Include="..\..\Share\Tools\Ini2Xaml\**\*.*">
            <Link>Publish\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>-->


    
    
