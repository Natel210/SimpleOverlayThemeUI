<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!--If you want, you can customize it by creating a target for the project location.-->
    <Target Name="GenerateDummyCurrentThemeXaml" BeforeTargets="Build" Condition="!Exists('$(ProjectDir)\SimpleOverlayTheme.targets')">
        <Message Text="****************************************" Importance="High" />
        <Message Text="**** [SimpleOverlayTheme] Generater Dummy Xaml From current.ini ****" Importance="High" />
        <Exec Command='"$(MSBuildThisFileDirectory)..\..\tools\net8.0\SimpleOverlayTheme.Ini2Xaml.exe" "$(TargetDir)Theme\current.ini" "$(ProjectDir)SimpleOverlayTheme\Dummy\CurrentTheme.xaml"' />
        <Message Text="**** [SimpleOverlayTheme] End ****" Importance="High" />
        <Message Text="****************************************" Importance="High" />
    </Target>

</Project>