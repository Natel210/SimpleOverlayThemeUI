<UserControl x:Class="SimpleOverlayTheme.Example.ExampleList.Component.BorderMaskImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimpleOverlayTheme.Example.ExampleList.Component"
             xmlns:helpers="clr-namespace:SimpleOverlayTheme.Helpers;assembly=SimpleOverlayTheme"
             mc:Ignorable="d" Background="White">
    <UserControl.Resources>
        <Style x:Key="borderMaskAll" TargetType="Border" BasedOn="{StaticResource SimpleOverlayTheme.Styles.BorderStyle.Mask}">
            <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.ColorPalette.Mask}"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtActive" Value="True"/>
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtDisable" Value="True"/>
            <Setter Property="helpers:BorderHelper.CustomMask_Use_AtMouseover" Value="True"/>
            <Setter Property="helpers:BorderHelper.Mask_DefaultImageBrush">
                <Setter.Value>
                    <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme.Example;component/Resource/Mask/check.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:BorderHelper.CustomMask_ImageBrush_AtActive">
                <Setter.Value>
                    <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme.Example;component/Resource/Mask/close.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:BorderHelper.CustomMask_ImageBrush_AtDisable">
                <Setter.Value>
                    <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme.Example;component/Resource/Mask/maximize.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:BorderHelper.CustomMask_ImageBrush_AtMouseover">
                <Setter.Value>
                    <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme.Example;component/Resource/Mask/upArrow.png"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <GroupBox Header="Mask Image" Style="{StaticResource PlateGroupBox}" FontSize="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header3}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource borderMaskAll}" helpers:BorderHelper.Overlay_State="Active"/>
            <Label Grid.Row="0" Grid.Column="1" Content="Active" VerticalContentAlignment="Center" Style="{StaticResource SimpleOverlayTheme.Styles.LabelStyle.Label}" FontSize="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header4}"/>
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource borderMaskAll}" helpers:BorderHelper.Overlay_State="Default"/>
            <Label Grid.Row="1" Grid.Column="1" Content="Default" VerticalContentAlignment="Center" Style="{StaticResource SimpleOverlayTheme.Styles.LabelStyle.Label}" FontSize="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header4}"/>
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource borderMaskAll}" helpers:BorderHelper.Overlay_State="Disable"/>
            <Label Grid.Row="2" Grid.Column="1" Content="Disable" VerticalContentAlignment="Center" Style="{StaticResource SimpleOverlayTheme.Styles.LabelStyle.Label}" FontSize="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header4}"/>
            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource borderMaskAll}" helpers:BorderHelper.Overlay_State="Mouseover"/>
            <Label Grid.Row="3" Grid.Column="1" Content="Mouseover" VerticalContentAlignment="Center" Style="{StaticResource SimpleOverlayTheme.Styles.LabelStyle.Label}" FontSize="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header4}"/>
        </Grid>
    </GroupBox>
</UserControl>
