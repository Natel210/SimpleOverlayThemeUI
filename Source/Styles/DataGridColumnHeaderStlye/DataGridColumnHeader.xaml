<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:helpers="clr-namespace:SimpleOverlayTheme.Helpers"
                    xmlns:converters="clr-namespace:SimpleOverlayTheme.Converters"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SimpleOverlayTheme;component/Styles/BorderStyle/Border.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/SimpleOverlayTheme;component/Styles/BorderStyle/Overlay.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/SimpleOverlayTheme;component/Styles/BorderStyle/Mask.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/SimpleOverlayTheme;component/Styles/BorderStyle/OverlayMask.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <converters:AlphaMultiplyConverter x:Key="AlphaMultiplyConverter" />
    <Style x:Key="SimpleOverlayTheme.Styles.DataGridColumnHeaderStyle.DataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.ColorPalette.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.ColorPalette.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.ColorPalette.Outline}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="2,3,2,3"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="helpers:DataGridColumnHeaderHelper.UseSortImageMask" Value="True"/>
        <Setter Property="helpers:DataGridColumnHeaderHelper.AscendingImageMask">
            <Setter.Value>
                <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme;component/Resource/Mask/SortAsc.png"/>
            </Setter.Value>
        </Setter>
        <Setter Property="helpers:DataGridColumnHeaderHelper.DescendingImageMask">
            <Setter.Value>
                <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme;component/Resource/Mask/SortDesc.png"/>
            </Setter.Value>
        </Setter>
        <Setter Property="helpers:OverlayDesplayHelper.Background" Value="True"/>
        <Setter Property="helpers:OverlayDesplayHelper.BackgroundAtDefault" Value="False"/>
        <Setter Property="helpers:OverlayDesplayHelper.Outline" Value="False"/>
        <Setter Property="helpers:OverlayDesplayHelper.OutlineAtDefault" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border x:Name="PART_MainBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Style="{StaticResource SimpleOverlayTheme.Styles.BorderStyle.Border}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                            <Border x:Name="PART_Overlay" Grid.ColumnSpan="2"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    HorizontalAlignment="Stretch"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                    Style="{StaticResource SimpleOverlayTheme.Styles.BorderStyle.Overlay}"
                                    VerticalAlignment="Stretch"
                                    helpers:BorderHelper.OverlayState="Default"
                                    helpers:OverlayDesplayHelper.Background="{TemplateBinding helpers:OverlayDesplayHelper.Background}"
                                    helpers:OverlayDesplayHelper.BackgroundAtDefault="{TemplateBinding helpers:OverlayDesplayHelper.BackgroundAtDefault}"
                                    helpers:OverlayDesplayHelper.Outline="{TemplateBinding helpers:OverlayDesplayHelper.Outline}"
                                    helpers:OverlayDesplayHelper.OutlineAtDefault="{TemplateBinding helpers:OverlayDesplayHelper.OutlineAtDefault}"/>
                            <Border x:Name="PART_SortBarMask" Grid.Column="1"
                                    Style="{StaticResource SimpleOverlayTheme.Styles.BorderStyle.Mask}"
                                    Width="{Binding ActualHeight, ElementName=PART_MainBorder}">
                                <Border.Background>
                                    <Binding Path="Foreground"
                                             RelativeSource="{RelativeSource TemplatedParent}"
                                             Converter="{StaticResource AlphaMultiplyConverter}"
                                             ConverterParameter="0.8"/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="PART_SortBarOverlayMask" Grid.Column="1"
                                    Style="{StaticResource SimpleOverlayTheme.Styles.BorderStyle.OverlayMask}"
                                    Width="{Binding ActualHeight, ElementName=PART_MainBorder}">
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" Grid.Column="1"
                                   Background="Transparent" HorizontalAlignment="Right"
                                   Cursor="SizeWE" BorderBrush="Transparent"
                                   BorderThickness="1" Width="1" Style="{x:Null}"
                                   Opacity="0"/>
                            <Thumb x:Name="PART_LeftHeaderGripper" Grid.Column="0"
                                   Background="Transparent" HorizontalAlignment="Left"
                                   Cursor="SizeWE" BorderBrush="Transparent"
                                   BorderThickness="1" Width="1" Style="{x:Null}"
                                   Opacity="0"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--At First-->
                        <Trigger Property="DisplayIndex" Value="0">
                            <Setter TargetName="PART_LeftHeaderGripper" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <!--Not Use Sort Mask-->
                        <Trigger Property="helpers:DataGridColumnHeaderHelper.UseSortImageMask" Value="False">
                            <Setter TargetName="PART_SortBarMask" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_SortBarMask" Property="OpacityMask" Value="{x:Null}"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="OpacityMask" Value="{x:Null}"/>
                        </Trigger>                        
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="helpers:DataGridColumnHeaderHelper.UseSortImageMask" Value="True"/>
                                <Condition Property="SortDirection" Value="Ascending"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_SortBarMask" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_SortBarMask" Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:DataGridColumnHeaderHelper.DescendingImageMask)}"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:DataGridColumnHeaderHelper.DescendingImageMask)}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="helpers:DataGridColumnHeaderHelper.UseSortImageMask" Value="True"/>
                                <Condition Property="SortDirection" Value="Descending"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_SortBarMask" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_SortBarMask" Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:DataGridColumnHeaderHelper.AscendingImageMask)}"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="OpacityMask" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:DataGridColumnHeaderHelper.AscendingImageMask)}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="helpers:DataGridColumnHeaderHelper.UseSortImageMask" Value="True"/>
                                <Condition Property="SortDirection" Value="{x:Null}"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_SortBarMask" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_SortBarMask" Property="OpacityMask" Value="{x:Null}"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="OpacityMask" Value="{x:Null}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Overlay" Property="helpers:BorderHelper.OverlayState" Value="Disable"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="helpers:BorderHelper.OverlayState" Value="Disable"/>
                            <Setter TargetName="PART_SortBarMask" Property="Background" Value="{DynamicResource SimpleOverlayTheme.ThemeKey.ColorPalette.Foreground_Disable}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Overlay" Property="helpers:BorderHelper.OverlayState" Value="Mouseover"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="helpers:BorderHelper.OverlayState" Value="Mouseover"/>
                        </Trigger>
                       <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Overlay" Property="helpers:BorderHelper.OverlayState" Value="Active"/>
                            <Setter TargetName="PART_SortBarOverlayMask" Property="helpers:BorderHelper.OverlayState" Value="Active"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">

            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>