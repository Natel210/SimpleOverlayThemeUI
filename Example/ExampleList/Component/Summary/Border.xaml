<UserControl x:Class="SimpleOverlayTheme.Example.ExampleList.Component.Summary.Border"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimpleOverlayTheme.Example.ExampleList.Component.Summary"
             xmlns:helpers="clr-namespace:SimpleOverlayTheme.Helpers;assembly=SimpleOverlayTheme"
             mc:Ignorable="d"
             Style="{StaticResource SimpleOverlayTheme.Styles.UserControlStyle.Empty}"
             d:Style="{StaticResource SimpleOverlayTheme.Styles.UserControlStyle.UserControl}">
    <UserControl.Resources>
        <Style x:Key="GroupBox_Border" TargetType="GroupBox" BasedOn="{StaticResource SimpleOverlayTheme.Styles.GroupBoxStyle.GroupBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Label Content="{Binding}" Background="#8873abff"
                   VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                   VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="10,2"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header4}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="#8873abff"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:GroupBoxHelper.HeaderUnderLineHeight" Value="0"/>
            <Setter Property="helpers:GroupBoxHelper.HeaderUnderLineBrush">
                <Setter.Value>
                    <SolidColorBrush Color="#8873abff"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label_Border" TargetType="Label" BasedOn="{StaticResource SimpleOverlayTheme.Styles.LabelStyle.Label}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header4}"/>
        </Style>
    </UserControl.Resources>
    <GroupBox Header="Border" Style="{StaticResource GroupBox_Border}"
              FontSize="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header3}"
              Padding="10"
              helpers:GroupBoxHelper.CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0"
                    Width="50"
                    Height="50"
                    Style="{StaticResource SimpleOverlayTheme.Styles.BorderStyle.Border}"
                    Background="#73abff"
                    BorderBrush="Black"
                    BorderThickness="2"/>
            <Label Grid.Row="0" Grid.Column="1"
                   Content="Border"
                   Margin="10,0,0,0"
                   Style="{StaticResource Label_Border}"/>
            <Border Grid.Row="1" Grid.Column="0"
                    Width="50"
                    Height="50"
                    Style="{StaticResource SimpleOverlayTheme.Styles.BorderStyle.Empty}"/>
            <Label Grid.Row="1" Grid.Column="1"
                   Content="Empty"
                   Margin="10,0,0,0"
                   Style="{StaticResource Label_Border}"/>
            <Border Grid.Row="3" Grid.Column="0"
                    Width="50"
                    Height="50"
                    Style="{StaticResource SimpleOverlayTheme.Styles.BorderStyle.Mask}"
                    Background="#73abff">
                <helpers:OverlayMaskImageHelper.DefaultImageMask>
                    <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme.Example;component/Resource/Mask/check.png"/>
                </helpers:OverlayMaskImageHelper.DefaultImageMask>
            </Border>
            <Label Grid.Row="3" Grid.Column="1"
                   Content="Mask"
                   Margin="10,0,0,0"
                   Style="{StaticResource Label_Border}"/>
        </Grid>
    </GroupBox>
</UserControl>