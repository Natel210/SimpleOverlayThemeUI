<Window x:Class="SimpleOverlayTheme.Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleOverlayTheme.Example"
        xmlns:exampleList="clr-namespace:SimpleOverlayTheme.Example.ExampleList"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1123">
    <Grid>
        <TabControl>
            <TabItem Header="Summary">
                <exampleList:SummaryExample/>
            </TabItem>

            <TabItem Header="Overlay">
                <exampleList:OverlayExample/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
