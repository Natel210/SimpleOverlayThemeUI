<UserControl x:Class="SimpleOverlayTheme.Example.ExampleList.Component.Overlay.BorderMaskImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimpleOverlayTheme.Example.ExampleList.Component.Overlay"
             xmlns:helpers="clr-namespace:SimpleOverlayTheme.Helpers;assembly=SimpleOverlayTheme"
             mc:Ignorable="d"
             Style="{StaticResource SimpleOverlayTheme.Styles.UserControlStyle.Empty}"
             d:Style="{StaticResource SimpleOverlayTheme.Styles.UserControlStyle.UserControl}">
    <UserControl.Resources>
        <Style TargetType="GroupBox" BasedOn="{StaticResource SimpleOverlayTheme.Styles.GroupBoxStyle.GroupBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Label Content="{Binding}" Background="#88888888"
                   VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                   VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="10,2"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header4}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="#88888888"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:GroupBoxHelper.HeaderUnderLineHeight" Value="0"/>
            <Setter Property="helpers:GroupBoxHelper.HeaderUnderLineBrush">
                <Setter.Value>
                    <SolidColorBrush Color="#88888888"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label" BasedOn="{StaticResource SimpleOverlayTheme.Styles.LabelStyle.Label}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header4}"/>
        </Style>
        <Style x:Key="borderMaskAll" TargetType="Border" BasedOn="{StaticResource SimpleOverlayTheme.Styles.BorderStyle.Mask}">
            <Setter Property="Background" Value="#888888"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="helpers:OverlayMaskImageHelper.UseActiveImageMask" Value="True"/>
            <Setter Property="helpers:OverlayMaskImageHelper.UseDisableImageMask" Value="True"/>
            <Setter Property="helpers:OverlayMaskImageHelper.UseMouseoverImageMask" Value="True"/>
            <Setter Property="helpers:OverlayMaskImageHelper.DefaultImageMask">
                <Setter.Value>
                    <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme.Example;component/Resource/Mask/Numeric1Box.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:OverlayMaskImageHelper.ActiveImageMask">
                <Setter.Value>
                    <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme.Example;component/Resource/Mask/Numeric2Box.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:OverlayMaskImageHelper.DisableImageMask">
                <Setter.Value>
                    <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme.Example;component/Resource/Mask/Numeric3Box.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="helpers:OverlayMaskImageHelper.MouseoverImageMask">
                <Setter.Value>
                    <ImageBrush ImageSource="pack://application:,,,/SimpleOverlayTheme.Example;component/Resource/Mask/Numeric4Box.png"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <GroupBox Header="Mask Image"
              FontSize="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header3}"
              Padding="10"
              helpers:CornerRadiusHelper.CornerRadius="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource borderMaskAll}"
                    helpers:BorderHelper.OverlayState="Active"/>
            <Label Grid.Row="0" Grid.Column="1" Content="Active"/>
            <Border Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource borderMaskAll}"
                    helpers:BorderHelper.OverlayState="Default"/>
            <Label Grid.Row="1" Grid.Column="1" Content="Default"/>
            <Border Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource borderMaskAll}"
                    helpers:BorderHelper.OverlayState="Disable"/>
            <Label Grid.Row="2" Grid.Column="1" Content="Disable"/>
            <Border Grid.Row="3" Grid.Column="0"
                    Style="{StaticResource borderMaskAll}"
                    helpers:BorderHelper.OverlayState="Mouseover"/>
            <Label Grid.Row="3" Grid.Column="1" Content="Mouseover"/>
        </Grid>
    </GroupBox>
</UserControl>