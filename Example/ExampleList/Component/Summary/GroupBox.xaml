<UserControl x:Class="SimpleOverlayTheme.Example.ExampleList.Component.Summary.GroupBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimpleOverlayTheme.Example.ExampleList.Component.Summary"
             xmlns:helpers="clr-namespace:SimpleOverlayTheme.Helpers;assembly=SimpleOverlayTheme"
             mc:Ignorable="d" 
             Style="{StaticResource SimpleOverlayTheme.Styles.UserControlStyle.Empty}"
             d:Style="{StaticResource SimpleOverlayTheme.Styles.UserControlStyle.UserControl}">
    <UserControl.Resources>
        <Style TargetType="GroupBox" BasedOn="{StaticResource SimpleOverlayTheme.Styles.GroupBoxStyle.GroupBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#8858823e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header3}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Label Content="{Binding}"
                               Background="#8858823e"
                               VerticalAlignment="Stretch"
                               HorizontalAlignment="Stretch"
                               VerticalContentAlignment="Center"
                               HorizontalContentAlignment="Center"
                               Style="{StaticResource SimpleOverlayTheme.Styles.LabelStyle.Label}"
                               Padding="10,2"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="helpers:GroupBoxHelper.HeaderUnderLineHeight" Value="0"/>
            <Setter Property="helpers:GroupBoxHelper.HeaderUnderLineBrush" Value="#8858823e"/>
        </Style>
    </UserControl.Resources>
    <GroupBox Header="GroupBox"
              Padding="10"
              helpers:CornerRadiusHelper.CornerRadius="20">
        <GroupBox Header="GroupBox"
                  VerticalAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Style="{StaticResource SimpleOverlayTheme.Styles.GroupBoxStyle.GroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <Label Content="{Binding}"
                           Background="#58823e"
                           FontSize="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header4}"
                           Style="{StaticResource SimpleOverlayTheme.Styles.LabelStyle.Label}"
                           Padding="10,2"/>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <TextBlock Text="Content"
                       Style="{StaticResource SimpleOverlayTheme.Styles.TextBlockStyle.TextBlock}"
                       FontSize="{StaticResource SimpleOverlayTheme.ThemeKey.FontSize.Header4}"/>
        </GroupBox>
    </GroupBox>
</UserControl>
