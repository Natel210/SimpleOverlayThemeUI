<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <BaseOutputPath>Bin\</BaseOutputPath>
    <!-- Local Test -->
    <VersionPrefix>999.0.4</VersionPrefix>
  </PropertyGroup>

  <!-- NuGet --><!--
  <PropertyGroup>
    <Authors>Natel210</Authors>
    <PackageLicenseExpression>$(Copyright)</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Natel210/SimpleOverlayThemeUI</PackageProjectUrl>
    --><!--<PackageIcon>none.png</PackageIcon>--><!--
    <PackageTags>Simple;Theme;OverlayTheme;SimpleTheme;SimpleOverlayThemeUI</PackageTags>
    --><!--<PackageReleaseNotes>https://github.com/Natel210/SimpleOverlayThemeUI/releases</PackageReleaseNotes>--><!--
    <RepositoryUrl>https://github.com/Natel210/SimpleOverlayThemeUI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(BaseOutputPath)/$(Configuration)/$(TargetFramework)/$(AssemblyName).xml</DocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>$(AssemblyName)</Title>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>-->

  <!-- Package Add -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.0.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="SimpleFileIO" Version="0.1.6" />
    <PackageReference Include="WpfAnalyzers" Version="4.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="XAMLTools.MSBuild" Version="1.0.0-alpha0167">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Add PackageIn -->
  <ItemGroup>
      <Content Include="Build\CurrentThemeGeneraterToXaml.targets">
          <Pack>True</Pack>
          <PackagePath>Build\</PackagePath>
      </Content>
  </ItemGroup>    
    
    
  <ItemGroup>
    <Compile Update="Resource\StringDictionary\ErrorCodes\ErrorMessage.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ErrorMessage.resx</DependentUpon>
    </Compile>
    <Compile Update="Resource\StringDictionary\Helper\HelperKey.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>HelperKey.resx</DependentUpon>
    </Compile>
    <Compile Update="Resource\StringDictionary\Theme\ThemeKey.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ThemeKey.resx</DependentUpon>
    </Compile>
  </ItemGroup>    
    
    
  <ItemGroup>
    <EmbeddedResource Update="Resource\StringDictionary\ErrorCodes\ErrorMessage.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ErrorMessage.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resource\StringDictionary\Helper\HelperKey.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>HelperKey.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resource\StringDictionary\Theme\ThemeKey.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ThemeKey.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>    


</Project>
