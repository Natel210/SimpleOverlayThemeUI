<UserControl x:Class="SimpleOverlayTheme.Example.ExampleList.OverlayExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimpleOverlayTheme.Example.ExampleList"
             mc:Ignorable="d"
             xmlns:component="clr-namespace:SimpleOverlayTheme.Example.ExampleList.Component.Overlay"
             Style="{StaticResource SimpleOverlayTheme.Styles.UserControlStyle.Empty}"
             d:Style="{StaticResource SimpleOverlayTheme.Styles.UserControlStyle.UserControl}">
    <UserControl.Resources>
        
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel>
            
            
            
            <StackPanel Orientation="Horizontal">
                <StackPanel><component:BorderMaskImage Margin="5"/></StackPanel>
                <StackPanel><component:BorderOverlay Margin="5"/></StackPanel>
                <StackPanel><component:BorderOverlayMask Margin="5"/></StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
